<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion Condition="'$(SelfContained)' == 'true'">8.0.33</RuntimeFrameworkVersion>
    <AssemblyName>Revora</AssemblyName>
    <RootNamespace>Revora</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0-beta</Version><AssemblyVersion>0.1.0.0</AssemblyVersion><FileVersion>0.1.0.0</FileVersion><InformationalVersion>0.1.0 Beta</InformationalVersion><Product>Revora</Product><Title>Revora 0.1.0 Beta</Title><ApplicationIcon>Assets\Revora.ico</ApplicationIcon>
    <Description>Revora – Updates für deine Programme · 0.1.0 Beta</Description>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup><Resource Include="Views\*.xaml" /><Resource Include="Assets\Revora.ico" /></ItemGroup>
  <Target Name="CopyRuntimeLicenses" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <MakeDir Directories="$(PublishDir)licenses" />
    <Copy SourceFiles="$(NuGetPackageRoot)microsoft.netcore.app.runtime.win-x64\$(RuntimeFrameworkVersion)\LICENSE.TXT" DestinationFiles="$(PublishDir)licenses\NETCore-LICENSE.txt" />
    <Copy SourceFiles="$(NuGetPackageRoot)microsoft.netcore.app.runtime.win-x64\$(RuntimeFrameworkVersion)\THIRD-PARTY-NOTICES.TXT" DestinationFiles="$(PublishDir)licenses\NETCore-THIRD-PARTY-NOTICES.txt" />
    <Copy SourceFiles="$(NuGetPackageRoot)microsoft.windowsdesktop.app.runtime.win-x64\$(RuntimeFrameworkVersion)\LICENSE" DestinationFiles="$(PublishDir)licenses\WindowsDesktop-LICENSE.txt" />
  </Target>
</Project>
