<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Programmordner auswählen" Width="620" Height="580" MinWidth="480" MinHeight="420" WindowStartupLocation="CenterOwner" Background="#101E2D" Foreground="#E8F5FF" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary Source="Theme.xaml"/></Window.Resources>
 <Grid Margin="22" Background="#101E2D"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer Padding="0,0,10,0"><StackPanel><TextBlock Text="Programmordner" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="LocationProgram" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock x:Name="LocationNote" Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
 <ListBox x:Name="LocationChoices" AutomationProperties.Name="Gefundene Installationen" MaxHeight="400"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#A3BAD6" FontSize="12" Margin="0,8,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
 <Button x:Name="BrowseLocation" Content="Anderen Ordner wählen" HorizontalAlignment="Left" Margin="0,18,0,0"/>
 </StackPanel></ScrollViewer>
 <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,18,0,0"><Button x:Name="CancelLocation" Content="Schließen" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="OpenLocation" Content="Ordner öffnen" Style="{StaticResource Primary}" IsEnabled="False"/></WrapPanel>
 </Grid>
</Window>
