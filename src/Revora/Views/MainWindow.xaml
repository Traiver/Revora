<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Revora · 0.1.0 Beta" Width="860" Height="760" MinWidth="520" MinHeight="480" WindowStartupLocation="CenterScreen" Background="#0D1825" Foreground="#E8F5FF" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary Source="Theme.xaml"/></Window.Resources>
 <Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C3042"/><GradientStop Color="#0D1825" Offset="0.7"/></LinearGradientBrush></Grid.Background>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="24,22,24,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="BrandIcon" Source="{StaticResource RevoraIcon}" Width="34" Height="34" Margin="0,0,10,0"/><TextBlock Text="Revora" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="#233C50" CornerRadius="6" Padding="7,3" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="0.1.0 Beta" Foreground="#A3BAD6" FontSize="10"/></Border></StackPanel>
   <Button Grid.Column="1" x:Name="CheckButton" Content="Updates suchen" Style="{StaticResource Primary}" Padding="15,10"/>
  </Grid>
  <ScrollViewer Grid.Row="1" x:Name="MainScroll" Padding="24,0,24,20"><StackPanel x:Name="MainContent">
   <StackPanel Margin="0,4,0,22"><TextBlock x:Name="HeroTitle" Text="Deine Programme" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Updatesuche wird vorbereitet …" Foreground="#B9E1FA" Margin="0,12,0,0"/><TextBlock x:Name="SummaryText" Text="Die Suche startet automatisch. Danach entscheidest du, was installiert wird." Style="{StaticResource MutedText}" Margin="0,5,0,0"/><ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Height="3" Margin="0,14,0,0" Foreground="#9ECCE9" Background="#203448" BorderThickness="0" Visibility="Collapsed"/></StackPanel>
   <Border x:Name="ProgramsCard" Visibility="Collapsed"><StackPanel>
    <TextBlock Text="Programme suchen" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="SearchBox" Height="38" VerticalScrollBarVisibility="Disabled" TextWrapping="NoWrap" AutomationProperties.Name="Programme durchsuchen" ToolTip="Nach Name oder Quelle filtern"/>
    <WrapPanel Margin="0,12,0,10"><CheckBox x:Name="OnlyUpdates" IsChecked="True" Content="Nur Updates" VerticalAlignment="Center" Margin="0,0,16,6"/><Button x:Name="SelectVisible" Content="Updates auswählen" Style="{StaticResource QuietButton}" ToolTip="Wählt die angezeigten, eindeutig zugeordneten Updates aus. Andere Einträge wählst du einzeln." Margin="0,0,8,6"/><Button x:Name="ClearSelection" Content="Auswahl aufheben" Style="{StaticResource QuietButton}" Margin="0,0,0,6"/></WrapPanel>
    <TextBlock x:Name="EmptyText" Text="Keine passenden Programme." Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="0,12,0,20"/>
    <ListBox x:Name="ProgramsList" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Erkannte Programme"><ListBox.ItemTemplate><DataTemplate>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInstall}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Top" Margin="0,2,0,0" ToolTip="Zum Aktualisieren auswählen"/>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding VersionLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="12" Margin="0,4,0,0"/>
       <TextBlock Text="{Binding InstallationsNotice}" TextWrapping="Wrap" Foreground="#EDBD91" FontSize="11" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding InstallationsNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock Text="{Binding NotificationHint}" Foreground="#A3BAD6" FontSize="11" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><DataTrigger Binding="{Binding NotificationHint}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><WrapPanel Margin="-7,8,0,0"><Button x:Name="ChangeSourceButton" Tag="{Binding Key}" Content="Quelle ändern" Style="{StaticResource QuietButton}" ToolTip="{Binding SourceLabel}" Margin="0,0,8,0"/><Button x:Name="OpenInstallFolderButton" Tag="{Binding Key}" Content="Ordner öffnen" Style="{StaticResource QuietButton}" ToolTip="Gefundene Programmordner anzeigen" Margin="0,0,8,0"/><Button x:Name="MuteUpdatesButton" Tag="{Binding Key}" Content="{Binding NotificationAction}" Style="{StaticResource QuietButton}" ToolTip="Schaltet Erinnerungen für dieses Programm dauerhaft aus oder wieder ein. Ausgeblendete Programme werden bei „Updates auswählen“ übersprungen."/></WrapPanel>
      </StackPanel>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate></ListBox>
    <Button x:Name="AddSource" Content="Programm hinzufügen" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="-7,8,0,12"/>
    <Expander x:Name="Diagnostics" Header="Suchbericht" Margin="0,0,0,12"><TextBox x:Name="DiagnosticReport" IsReadOnly="True" MinHeight="100" MaxHeight="240" FontFamily="Consolas" FontSize="11" AutomationProperties.Name="Scanbericht"/></Expander>
   </StackPanel></Border>
   <Border BorderBrush="#2B4358" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0"><Expander Header="Einstellungen"><StackPanel>
    <CheckBox x:Name="StartupOption" Content="Mit Windows starten"/><TextBlock x:Name="StartupHint" Style="{StaticResource MutedText}" FontSize="11" Margin="30,6,0,0"/>
    <TextBlock x:Name="FooterText" Style="{StaticResource MutedText}" FontSize="11" Margin="0,16,0,0"/><TextBlock Text="Steam-Spiele werden bei der Suche ausgelassen." Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/>
   </StackPanel></Expander></Border>
  </StackPanel></ScrollViewer>
  <Border x:Name="ActionBar" Grid.Row="2" Background="#142536" BorderBrush="#30485E" BorderThickness="0,1,0,0" Padding="24,14" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectionText" Text="Nichts ausgewählt" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Grid.Column="1" x:Name="InstallButton" Content="Auswahl prüfen" ToolTip="Zeigt zuerst die Auswahl. Installiert erst nach deiner Bestätigung." Style="{StaticResource Primary}" IsEnabled="False"/></Grid></Border>
 </Grid>
</Window>