<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Auswahl prüfen" Width="640" Height="620" MinWidth="480" MinHeight="420" WindowStartupLocation="CenterOwner" Background="#101E2D" Foreground="#E8F5FF" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary Source="Theme.xaml"/></Window.Resources>
 <Grid Margin="22" Background="#101E2D"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer Padding="0,0,10,0"><StackPanel><TextBlock x:Name="ReviewTitle" Text="Auswahl prüfen" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ReviewIntro" Style="{StaticResource MutedText}" Margin="0,10,0,20"/>
   <ItemsControl x:Name="ReviewItems"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#142536" CornerRadius="14" BorderBrush="#30485E" BorderThickness="1" Padding="16" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#A3BAD6" FontSize="12" Margin="0,8,0,0"/><Expander Header="{Binding TechnicalLabel}" Visibility="{Binding TechnicalVisibility}" Margin="0,10,0,0"><TextBox Text="{Binding TechnicalDetails,Mode=OneWay}" IsReadOnly="True" MaxHeight="240" FontSize="11" FontFamily="Consolas"/></Expander></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <CheckBox x:Name="AckBox" Foreground="#E8F5FF" Margin="0,16,0,8"><TextBlock x:Name="AckText" Text="Ich habe meine Auswahl geprüft und möchte fortfahren." TextWrapping="Wrap"/></CheckBox>
  </StackPanel></ScrollViewer>
  <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,18,0,0"><Button x:Name="CancelReview" Content="Abbrechen" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="ConfirmReview" Content="Updates starten" Style="{StaticResource Primary}"/></WrapPanel>
 </Grid>
</Window>
